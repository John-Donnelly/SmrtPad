<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Mirror SmrtPad.AI: set RID so the LLamaSharp and OnnxRuntimeGenAI backend .props
         copy native DLLs into runtimes/{rid}/native/{variant}/ in the output directory.
         Without a RID the .props fallback copies everything flat and the cuda12 subdirectory
         that NativeLibraryConfig.WithSearchDirectory points at never gets created. -->
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64' AND '$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64' AND '$(RuntimeIdentifier)' == ''">win-arm64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <RootNamespace>SmrtPad.AI.Benchmarks</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);IDISP001;IDISP016</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.skippablefact" />
    <!-- LLamaSharp backends must be referenced directly here too so their .props activate
         and copy the native DLL subdirectories (cuda12/, avx2/, etc.) into the test output.
         Transitive native assets from a ProjectReference are not copied automatically. -->
    <PackageReference Include="LLamaSharp.Backend.Cpu" />
    <PackageReference Include="LLamaSharp.Backend.Cuda12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmrtPad.AI\SmrtPad.AI.csproj" />
  </ItemGroup>

</Project>
