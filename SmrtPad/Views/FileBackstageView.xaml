<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SmrtPad.Views.FileBackstageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation pane -->
        <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <NavigationView
                x:Name="Nav"
                PaneDisplayMode="Left"
                IsPaneOpen="True"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="False"
                IsSettingsVisible="False"
                SelectionChanged="Nav_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem x:Uid="NewNavItem" Content="New"     Tag="New"     Icon="Add" />
                    <NavigationViewItem x:Uid="OpenNavItem" Content="Open"    Tag="Open"    Icon="OpenFile" />
                    <NavigationViewItem x:Uid="SaveNavItem" Content="Save"    Tag="Save"    Icon="Save" />
                    <NavigationViewItem x:Uid="SaveAsNavItem" Content="Save as" Tag="SaveAs"  Icon="SaveLocal" />
                    <NavigationViewItem x:Uid="PrintNavItem" Content="Print"   Tag="Print"   Icon="Print" />
                    <NavigationViewItem x:Uid="ExportPdfNavItem" Content="Export to PDF" Tag="ExportPdf" Icon="Document" />
                    <NavigationViewItem x:Uid="ExportDocxNavItem" Content="Export to DOCX" Tag="ExportDocx" Icon="Document" />
                    <NavigationViewItem x:Uid="OneDriveNavItem" Content="Save to OneDrive" Tag="OneDrive" Icon="Upload" />
                    <NavigationViewItem x:Uid="OptionsNavItem" Content="Options" Tag="Options" Icon="Setting" />
                    <NavigationViewItem x:Uid="ExitNavItem" Content="Exit"    Tag="Exit"    Icon="LeaveChat" />
                </NavigationView.MenuItems>
                <NavigationView.Content>
                    <TextBlock />
                </NavigationView.Content>
            </NavigationView>
        </Border>

        <!-- Content pane -->
        <Grid Grid.Column="1" Padding="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="HeaderText" FontSize="24" FontWeight="SemiBold" Text="File" />

            <Border Grid.Row="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16" Margin="0,8,0,0">
                <TextBlock x:Name="BodyText" x:Uid="BackstageBodyDefault" TextWrapping="Wrap"
                           Text="Choose an option on the left." />
            </Border>

            <!-- Document properties panel -->
            <Border x:Name="DocPropertiesPanel" Grid.Row="2" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16" Margin="0,8,0,0">
                <StackPanel Spacing="6">
                    <TextBlock x:Uid="BackstageDocPropertiesHeader" Text="Document Properties" FontSize="16" FontWeight="SemiBold"/>
                    <Grid ColumnSpacing="12" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Uid="DocPropFileName" Grid.Row="0" Grid.Column="0" Text="File name:" Opacity="0.7"/>
                        <TextBlock x:Name="PropFileName" Grid.Row="0" Grid.Column="1"/>
                        <TextBlock x:Uid="DocPropWordCount" Grid.Row="1" Grid.Column="0" Text="Words:" Opacity="0.7"/>
                        <TextBlock x:Name="PropWordCount" Grid.Row="1" Grid.Column="1"/>
                        <TextBlock x:Uid="DocPropCharCount" Grid.Row="2" Grid.Column="0" Text="Characters:" Opacity="0.7"/>
                        <TextBlock x:Name="PropCharCount" Grid.Row="2" Grid.Column="1"/>
                        <TextBlock x:Uid="DocPropEncoding" Grid.Row="3" Grid.Column="0" Text="Encoding:" Opacity="0.7"/>
                        <TextBlock x:Name="PropEncoding" Grid.Row="3" Grid.Column="1"/>
                        <TextBlock x:Uid="DocPropModified" Grid.Row="4" Grid.Column="0" Text="Modified:" Opacity="0.7"/>
                        <TextBlock x:Name="PropModified" Grid.Row="4" Grid.Column="1"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="RecentFilesPanel" Grid.Row="3" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16" Margin="0,8,0,0">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="RecentFilesHeader" Text="Recent Files" FontSize="16" FontWeight="SemiBold"/>
                    <ItemsControl x:Name="RecentFilesList"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>