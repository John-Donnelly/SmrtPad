<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SmrtPad.Controls.SmartSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SmrtPad.Controls"
    xmlns:conv="using:SmrtPad.Converters"
    mc:Ignorable="d"
    Width="340"
    MinWidth="280">

    <UserControl.Transitions>
        <TransitionCollection>
            <RepositionThemeTransition />
        </TransitionCollection>
    </UserControl.Transitions>

    <UserControl.Resources>
        <conv:NonEmptyStringToVisibilityConverter x:Key="NonEmptyToVisible" />

        <!-- User bubble (right-aligned) -->
        <DataTemplate x:Key="UserBubbleTemplate">
            <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="12,12,2,12"
                    Padding="10,6"
                    Margin="32,4,4,4"
                    HorizontalAlignment="Right">
                <TextBlock Text="{Binding Text}"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                           IsTextSelectionEnabled="True"
                           FontSize="13" />
            </Border>
        </DataTemplate>

        <!-- Assistant bubble (left-aligned) with optional thinking expander and Insert button -->
        <DataTemplate x:Key="AssistantBubbleTemplate">
            <StackPanel Spacing="4" Margin="4,4,32,4" HorizontalAlignment="Stretch">

                <!-- Thinking section: visible only when ThinkingText is non-empty -->
                <Expander x:Name="ThinkingExpander"
                          Visibility="{Binding ThinkingText, Converter={StaticResource NonEmptyToVisible}}"
                          IsExpanded="{Binding IsThinkingPhase}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <TextBlock FontSize="11"
                                   FontStyle="Italic"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{Binding ThinkingLabel}" />
                    </Expander.Header>
                    <ScrollViewer MaxHeight="160"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding ThinkingText}"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   FontFamily="Consolas"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextSelectionEnabled="True" />
                    </ScrollViewer>
                </Expander>

                <!-- Answer bubble -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12,12,12,2"
                        Padding="10,6">
                    <TextBlock Text="{Binding Text}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"
                               FontSize="13" />
                </Border>
                <Button Content="Insert"
                        Tag="{Binding Text}"
                        Click="InsertBubbleButton_Click"
                        Padding="8,4"
                        FontSize="12"
                        HorizontalAlignment="Left" />
            </StackPanel>
        </DataTemplate>

        <local:SidebarChatTemplateSelector x:Key="ChatTemplateSelector"
            UserTemplate="{StaticResource UserBubbleTemplate}"
            AssistantTemplate="{StaticResource AssistantBubbleTemplate}" />
    </UserControl.Resources>

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
          BorderThickness="1,0,0,0"
          Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="✨ Smrt Sidebar" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="InitializationStatusText"
                           AutomationProperties.AutomationId="SmartSidebarStatusText"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
                <TextBlock x:Name="HardwareBadge"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Tapped="HardwareBadge_Tapped" />
            </StackPanel>
            <DropDownButton x:Name="OptionsButton" Grid.Column="1"
                            AutomationProperties.Name="Options"
                            Background="Transparent" BorderThickness="0" Padding="6"
                            VerticalAlignment="Top">
                <FontIcon Glyph="&#xE712;" FontSize="12" />
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="OptionsFlyout" Placement="Bottom">
                        <MenuFlyoutItem x:Name="NewSessionMenuItem"
                                        AutomationProperties.AutomationId="NewSessionMenuItem"
                                        Click="NewSessionMenuItem_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8BB;" FontSize="12" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator x:Name="ModelSeparator" Visibility="Collapsed" />
                        <MenuFlyoutSubItem x:Name="ModelSubMenu" Visibility="Collapsed">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon Glyph="&#xE9CE;" FontSize="12" />
                            </MenuFlyoutSubItem.Icon>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator x:Name="ExecutionTargetSeparator" Visibility="Collapsed" />
                        <MenuFlyoutSubItem x:Name="ExecutionTargetSubMenu" Visibility="Collapsed">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon Glyph="&#xE950;" FontSize="12" />
                            </MenuFlyoutSubItem.Icon>
                        </MenuFlyoutSubItem>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <Button x:Name="CloseButton" Grid.Column="2" Click="CloseButton_Click"
                    AutomationProperties.Name="Close sidebar"
                    Background="Transparent" BorderThickness="0" Padding="6"
                    VerticalAlignment="Top">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
        </Grid>

        <!-- ═══ CHAT HISTORY + SKILL CONTROLS (fills all remaining space) ═══ -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Chat history — expands to fill whatever space the skill section leaves -->
            <ListView x:Name="ChatHistoryList"
                      Grid.Row="0"
                      ItemTemplateSelector="{StaticResource ChatTemplateSelector}"
                      SelectionMode="None"
                      HorizontalContentAlignment="Stretch"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      AutomationProperties.AutomationId="ChatHistoryList">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <!-- Skill controls — anchored to the bottom of the chat area -->
            <StackPanel Grid.Row="1" Spacing="8" Margin="0,8,0,0">

                <!-- Responsible AI notice (collapsed until shown) -->
                <Border x:Name="ResponsibleAiBanner"
                        Padding="8"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ResponsibleAiNoticeText"
                               AutomationProperties.AutomationId="ResponsibleAiNoticeText"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>

                <!-- Skill dropdown + Apply row -->
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="SkillDropdown"
                              Grid.Column="0"
                              HorizontalAlignment="Stretch"
                              AutomationProperties.AutomationId="SkillDropdown"
                              SelectionChanged="SkillDropdown_SelectionChanged" />
                    <Button x:Name="ApplySkillButton"
                            Grid.Column="1"
                            Click="ApplySkillButton_Click"
                            AutomationProperties.AutomationId="ApplySkillButton"
                            IsEnabled="False"
                            Padding="10,6">
                        <FontIcon Glyph="&#xE768;" FontSize="13" />
                    </Button>
                </Grid>

                <!-- Tone toggle (shown when a tone skill is selected) -->
                <ToggleSwitch x:Name="ToneToggle"
                              OnContent="Professional" OffContent="Casual"
                              AutomationProperties.AutomationId="ToneToggleSwitch"
                              IsOn="True"
                              Visibility="Collapsed" />

                <!-- Semantic search (shown when semantic skill selected) -->
                <StackPanel x:Name="SemanticSection" Spacing="6" Visibility="Collapsed">
                    <Grid x:Name="OcrDropHost">
                        <Border x:Name="OcrDropZone"
                                AutomationProperties.AutomationId="OcrDropZone"
                                AllowDrop="True"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                DragOver="OcrDropZone_DragOver"
                                Drop="OcrDropZone_Drop">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="OcrDropPromptText" FontWeight="SemiBold" />
                                <TextBlock x:Name="OcrDropHintText"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ProgressRing x:Name="OcrProgress" IsActive="False" Visibility="Collapsed"
                                  Width="20" Height="20" HorizontalAlignment="Left"
                                  AutomationProperties.Name="Loading" />
                    <AutoSuggestBox x:Name="SemanticSearchBox"
                                    PlaceholderText="Search across all tabs..."
                                    AutomationProperties.AutomationId="SemanticSearchBox"
                                    QuerySubmitted="SemanticSearchBox_QuerySubmitted" />
                    <ProgressRing x:Name="SearchProgress" IsActive="False" Visibility="Collapsed"
                                  Width="20" Height="20" HorizontalAlignment="Left"
                                  AutomationProperties.Name="Loading" />
                    <ListView x:Name="SearchResultsList" SelectionMode="Single"
                              SelectionChanged="SearchResultsList_SelectionChanged"
                              MaxHeight="200">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2">
                                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="999"
                                            HorizontalAlignment="Left"
                                            Padding="8,2">
                                        <TextBlock Text="{Binding TabName}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding ChunkText}" TextTrimming="CharacterEllipsis"
                                               MaxLines="2" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ═══ INPUT ROW ═══ -->
        <Grid Grid.Row="2" Margin="0,8,0,0" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ChatInputBox"
                     Grid.Column="0"
                     PlaceholderText="Ask anything…"
                     AutomationProperties.AutomationId="ChatInputBox"
                     TextWrapping="Wrap"
                     AcceptsReturn="False"
                     MaxHeight="80"
                     KeyDown="ChatInputBox_KeyDown" />
            <Button x:Name="SendChatButton"
                    Grid.Column="1"
                    Click="SendChatButton_Click"
                    AutomationProperties.Name="Send"
                    ToolTipService.ToolTip="Send (Enter)"
                    Padding="8">
                <FontIcon Glyph="&#xE724;" FontSize="14" />
            </Button>
            <Button x:Name="StopChatButton"
                    Grid.Column="2"
                    Click="StopChatButton_Click"
                    AutomationProperties.Name="Stop generation"
                    ToolTipService.ToolTip="Stop"
                    Visibility="Collapsed"
                    Padding="8">
                <FontIcon Glyph="&#xE71A;" FontSize="14" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
