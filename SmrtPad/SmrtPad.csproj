<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>SmrtPad</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- VS 2026 sets DOTNET_ROOT=<app_dir> during debug launch, so the app must be self-contained
         to ensure the .NET runtime is co-located with the executable. -->
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64' AND '$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64' AND '$(RuntimeIdentifier)' == ''">win-arm64</RuntimeIdentifier>
    <SelfContained Condition="'$(RuntimeIdentifier)' != '' AND '$(SelfContained)' == ''">true</SelfContained>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      MVVMTK0045: The WinUI XAML build pipeline uses a two-pass compilation where the first pass
      skips source generators (/skipanalyzers+). Partial property [ObservableProperty] declarations
      fail in this first pass because their implementations are only generated by the source generator.
      Field-based [ObservableProperty] works correctly. Suppress until the WinUI SDK supports
      single-pass compilation with source generators.
    -->
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SmrtPad.Tests" />
  </ItemGroup>


  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\SmrtPad.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\SmrtPad.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\SmrtPad-LM.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\SmrtDoodle.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\SmrtDoodle-LM.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Graphics.Win2D" />
    <PackageReference Include="Microsoft.Windows.Compatibility" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>




    <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
  </PropertyGroup>

  <Target Name="FlattenWinUiPageXbfOutputs" AfterTargets="Build">
    <ItemGroup>
      <FlattenedXbf Include="$(TargetDir)Controls\SmartSidebar.xbf" Condition="Exists('$(TargetDir)Controls\SmartSidebar.xbf')">
        <Destination>$(TargetDir)SmartSidebar.xbf</Destination>
      </FlattenedXbf>
      <FlattenedXbf Include="$(TargetDir)Views\FileBackstageView.xbf" Condition="Exists('$(TargetDir)Views\FileBackstageView.xbf')">
        <Destination>$(TargetDir)FileBackstageView.xbf</Destination>
      </FlattenedXbf>
    </ItemGroup>

    <Copy
      SourceFiles="@(FlattenedXbf)"
      DestinationFiles="@(FlattenedXbf->'%(Destination)')"
      SkipUnchangedFiles="true"
      Condition="@(FlattenedXbf) != ''" />
  </Target>
</Project>