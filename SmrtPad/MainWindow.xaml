<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SmrtPad.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SmrtPad"
    xmlns:views="using:SmrtPad.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SmrtPad">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- MenuBar -->
        <MenuBar Grid.Row="0">
            <MenuBarItem Title="File" Tapped="FileMenu_Tapped" />
            <MenuBarItem Title="Edit">
                <MenuFlyoutItem Text="Cut" Icon="Cut" Click="Cut_Click" />
                <MenuFlyoutItem Text="Copy" Icon="Copy" Click="Copy_Click" />
                <MenuFlyoutItem Text="Paste" Icon="Paste" Click="Paste_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Select All" Click="SelectAll_Click" />
            </MenuBarItem>
            <MenuBarItem Title="View">
                <MenuFlyoutItem Text="Zoom In" Icon="ZoomIn" Click="ZoomIn_Click" />
                <MenuFlyoutItem Text="Zoom Out" Icon="ZoomOut" Click="ZoomOut_Click" />
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem Text="Word Wrap" IsChecked="True" Click="WordWrap_Click" />
            </MenuBarItem>
        </MenuBar>

        <!-- Ribbon / CommandBar -->
        <CommandBar Grid.Row="1" DefaultLabelPosition="Right">
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Margin="10,0,0,0" Spacing="5">
                    <ComboBox x:Name="FontFamilyComboBox" Width="150" SelectionChanged="FontFamilyComboBox_SelectionChanged" />
                    <ComboBox x:Name="FontSizeComboBox" Width="70" SelectionChanged="FontSizeComboBox_SelectionChanged" IsEditable="True" />
                </StackPanel>
            </CommandBar.Content>
            <AppBarButton Icon="Bold" Label="Bold" Click="Bold_Click" />
            <AppBarButton Icon="Italic" Label="Italic" Click="Italic_Click" />
            <AppBarButton Icon="Underline" Label="Underline" Click="Underline_Click" />
            <AppBarButton Label="Strikethrough" Click="Strikethrough_Click">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEDE0;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Icon="FontDecrease" Label="Subscript" Click="Subscript_Click" />
            <AppBarButton Icon="FontIncrease" Label="Superscript" Click="Superscript_Click" />
            <AppBarSeparator />
            <AppBarButton Icon="AlignLeft" Label="Align Left" Click="AlignLeft_Click" />
            <AppBarButton Icon="AlignCenter" Label="Center" Click="AlignCenter_Click" />
            <AppBarButton Icon="AlignRight" Label="Align Right" Click="AlignRight_Click" />
            <AppBarButton Label="Justify" Click="AlignJustify_Click">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8E4;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton Label="Decrease Indent" Click="DecreaseIndent_Click">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8E7;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Increase Indent" Click="IncreaseIndent_Click">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8E8;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Icon="List" Label="Bullets" Click="Bullets_Click" />
            <AppBarSeparator />
            <AppBarButton Icon="FontColor" Label="Text Color">
                <AppBarButton.Flyout>
                    <Flyout>
                        <StackPanel>
                            <ColorPicker x:Name="TextColorPicker" ColorChanged="TextColorPicker_ColorChanged" />
                        </StackPanel>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton Icon="Highlight" Label="Highlight">
                <AppBarButton.Flyout>
                    <Flyout>
                        <StackPanel>
                            <ColorPicker x:Name="HighlightColorPicker" ColorChanged="HighlightColorPicker_ColorChanged" />
                        </StackPanel>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton Icon="Pictures" Label="Insert Picture" Click="InsertPicture_Click" />
            <AppBarButton Icon="Calendar" Label="Date/Time" Click="InsertDateTime_Click" />
            <AppBarSeparator />
            <!-- Image controls (visible when an inserted image is selected) -->
            <AppBarSeparator x:Name="ImageControlsSeparator" Visibility="Collapsed" />
            <AppBarButton x:Name="RemoveImageButton" Icon="Delete" Label="Remove Image" Click="RemoveImage_Click" Visibility="Collapsed" />
            <AppBarButton x:Name="ImageRotateLeftButton" Icon="Rotate" Label="Rotate Left" Click="RotateImageLeft_Click" Visibility="Collapsed" />
            <AppBarButton x:Name="ImageRotateRightButton" Icon="Rotate" Label="Rotate Right" Click="RotateImageRight_Click" Visibility="Collapsed" />
            <AppBarButton x:Name="ImageAlignLeftButton" Icon="AlignLeft" Label="Image Left" Click="ImageAlignLeft_Click" Visibility="Collapsed" />
            <AppBarButton x:Name="ImageAlignCenterButton" Icon="AlignCenter" Label="Image Center" Click="ImageAlignCenter_Click" Visibility="Collapsed" />
            <AppBarButton x:Name="ImageAlignRightButton" Icon="AlignRight" Label="Image Right" Click="ImageAlignRight_Click" Visibility="Collapsed" />
            <AppBarButton x:Name="ImageSetSizeButton" Label="Size" Visibility="Collapsed">
                <AppBarButton.Icon>
                    <SymbolIcon Symbol="Crop" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel Spacing="8" Width="220">
                            <TextBlock Text="Width" />
                            <NumberBox x:Name="ImageWidthBox" Minimum="1" Maximum="10000" SmallChange="10" SpinButtonPlacementMode="Inline" ValueChanged="ImageSizeBox_ValueChanged" />
                            <TextBlock Text="Height" />
                            <NumberBox x:Name="ImageHeightBox" Minimum="1" Maximum="10000" SmallChange="10" SpinButtonPlacementMode="Inline" ValueChanged="ImageSizeBox_ValueChanged" />
                            <ToggleSwitch x:Name="ImageLockAspectToggle" Header="Lock aspect" IsOn="True" Toggled="ImageLockAspectToggle_Toggled" />
                        </StackPanel>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton Icon="Find" Label="Find">
                <AppBarButton.Flyout>
                    <Flyout>
                        <StackPanel Spacing="5" Width="250">
                            <TextBox x:Name="FindTextBox" PlaceholderText="Find what..." />
                            <Button Content="Find Next" Click="FindNext_Click" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton Label="Replace">
                <AppBarButton.Icon>
                    <SymbolIcon Symbol="Refresh" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <Flyout>
                        <StackPanel Spacing="5" Width="250">
                            <TextBox x:Name="ReplaceFindTextBox" PlaceholderText="Find what..." />
                            <TextBox x:Name="ReplaceWithTextBox" PlaceholderText="Replace with..." />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="5">
                                <Button Content="Replace" Click="Replace_Click" />
                                <Button Content="Replace All" Click="ReplaceAll_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>
        </CommandBar>

        <!-- Main surface: editor + File backstage (WordPad-style) -->
        <Grid Grid.Row="2" Margin="10">
            <RichEditBox x:Name="Editor" AcceptsReturn="True" TextWrapping="Wrap" />
            <views:FileBackstageView x:Name="FileBackstage" Visibility="Collapsed" />
        </Grid>

        <!-- Status Bar -->
        <Grid Grid.Row="3" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" Padding="10,5">
            <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
