<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SmrtPad.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SmrtPad"
    xmlns:views="using:SmrtPad.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SmrtPad">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewDocument_Invoked"/>
            <KeyboardAccelerator Key="T" Modifiers="Control" Invoked="NewTab_Invoked"/>
            <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="CloseTab_Invoked"/>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OpenFind_Invoked"/>
            <KeyboardAccelerator Key="H" Modifiers="Control" Invoked="OpenReplace_Invoked"/>
            <KeyboardAccelerator Key="F3" Invoked="FindNextShortcut_Invoked"/>
            <KeyboardAccelerator Key="D" Modifiers="Control" Invoked="DuplicateLine_Invoked"/>
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ MENU BAR / QUICK-ACCESS TOOLBAR ═══ -->
        <Grid Grid.Row="0"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Height="34">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="0">
                <!-- File → backstage -->
                <Button x:Uid="FileMenuButton" Content="File" Click="FileMenu_Tapped"
                        AutomationProperties.AutomationId="FileMenuButton"
                        Padding="10,5" Background="Transparent" BorderThickness="0"
                        CornerRadius="0" FontSize="13"/>
                <!-- Edit / View menus -->
                <MenuBar VerticalAlignment="Center" Background="Transparent" Padding="0">
                    <MenuBarItem x:Uid="EditMenu" Title="Edit" AutomationProperties.AutomationId="EditMenuBarItem">
                        <MenuFlyoutItem x:Uid="CutMenuItem" Text="Cut" Click="Cut_Click" AutomationProperties.AutomationId="CutMenuItem">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C6;"/></MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="X" Modifiers="Control"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="CopyMenuItem" Text="Copy" Click="Copy_Click" AutomationProperties.AutomationId="CopyMenuItem">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;"/></MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="C" Modifiers="Control"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="PasteMenuItem" Text="Paste" Click="Paste_Click" AutomationProperties.AutomationId="PasteMenuItem">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77F;"/></MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="V" Modifiers="Control"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="PasteSpecialMenuItem" Text="Paste Special" Click="PasteSpecial_Click" AutomationProperties.AutomationId="PasteSpecialMenuItem">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77F;"/></MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="V" Modifiers="Control,Shift"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="SelectAllMenuItem" Text="Select All" Click="SelectAll_Click" AutomationProperties.AutomationId="SelectAllMenuItem">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="A" Modifiers="Control"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                    </MenuBarItem>
                    <MenuBarItem x:Uid="ViewMenu" Title="View" AutomationProperties.AutomationId="ViewMenuBarItem">
                        <MenuFlyoutItem x:Uid="ZoomInMenuItem" Text="Zoom In"  Icon="ZoomIn"  Click="ZoomIn_Click" AutomationProperties.AutomationId="ZoomInMenuItem">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Add" Modifiers="Control"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="ZoomOutMenuItem" Text="Zoom Out" Icon="ZoomOut" Click="ZoomOut_Click" AutomationProperties.AutomationId="ZoomOutMenuItem">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Subtract" Modifiers="Control"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutSubItem x:Uid="WordWrapMenuItem" Text="Word Wrap">
                            <MenuFlyoutItem x:Name="WordWrapOffItem"      x:Uid="WordWrapOffItem"      Text="No Wrap"        Click="WordWrap_Click" Tag="Off"
                                            AutomationProperties.AutomationId="WordWrapOffItem"/>
                            <MenuFlyoutItem x:Name="WordWrapWrapItem"     x:Uid="WordWrapWrapItem"     Text="Wrap"           Click="WordWrap_Click" Tag="Wrap"
                                            AutomationProperties.AutomationId="WordWrapWrapItem"/>
                            <MenuFlyoutItem x:Name="WordWrapToRulerItem"  x:Uid="WordWrapToRulerItem"  Text="Wrap to Ruler"  Click="WordWrap_Click" Tag="WrapToRuler"
                                            AutomationProperties.AutomationId="WordWrapToRulerItem"/>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem x:Name="SpellCheckToggle" x:Uid="SpellCheckToggle" Text="Spell Check" IsChecked="True" Click="SpellCheck_Click"
                                             AutomationProperties.AutomationId="SpellCheckToggle" />
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem x:Name="RulerToggle" x:Uid="RulerToggle" Text="Ruler" Click="Ruler_Click"
                                             AutomationProperties.AutomationId="RulerToggle" />
                        <ToggleMenuFlyoutItem x:Name="PageViewToggle" x:Uid="PageViewToggle" Text="Page View" Click="PageView_Click"
                                             AutomationProperties.AutomationId="PageViewToggle" />
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem x:Name="FocusModeToggle" x:Uid="FocusModeToggle" Text="Focus Mode" Click="FocusMode_Click"
                                             AutomationProperties.AutomationId="FocusModeToggle" />
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem x:Name="StatusBarToggle" x:Uid="StatusBarToggle" Text="Status Bar" IsChecked="True" Click="StatusBarToggle_Click"
                                             AutomationProperties.AutomationId="StatusBarToggle" />
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem x:Name="SmartSidebarToggle" x:Uid="SmartSidebarToggle" Text="✨ Smart Sidebar" Click="SmartSidebarToggle_Click"
                                             AutomationProperties.AutomationId="SmartSidebarToggle" />
                    </MenuBarItem>
                    <MenuBarItem x:Uid="FormatMenu" Title="Format">
                        <MenuFlyoutItem x:Uid="FormatFontMenuItem" Text="Font..." Click="FormatFont_Click"
                                        AutomationProperties.AutomationId="FormatFontMenuItem">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D2;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="FormatParagraphMenuItem" Text="Paragraph..." Click="FormatParagraph_Click"
                                        AutomationProperties.AutomationId="FormatParagraphMenuItem">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE1D0;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuBarItem>
                    <MenuBarItem x:Uid="MacroMenuBar" Title="Macro">
                        <MenuFlyoutItem x:Name="MacroRecordItem" Text="Record Macro" Click="MacroRecord_Click"
                                        AutomationProperties.AutomationId="MacroRecordItem">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7C8;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MacroStopItem" Text="Stop Recording" Click="MacroStop_Click" IsEnabled="False"
                                        AutomationProperties.AutomationId="MacroStopItem">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71A;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem x:Name="MacroRunItem" Text="Run Macro" Click="MacroRun_Click"
                                        AutomationProperties.AutomationId="MacroRunItem">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem x:Name="MacroSaveItem" Text="Save Macro" Click="MacroSave_Click"
                                        AutomationProperties.AutomationId="MacroSaveItem">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MacroLoadItem" Text="Load Macro" Click="MacroLoad_Click"
                                        AutomationProperties.AutomationId="MacroLoadItem">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuBarItem>
                    <MenuBarItem x:Uid="WindowMenu" Title="Window">
                        <MenuFlyoutItem x:Uid="NewWindowMenuItem" Text="New Window" Click="NewWindow_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE78B;"/></MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="N" Modifiers="Control,Shift"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                    </MenuBarItem>
                </MenuBar>
                <!-- Quick-access separator -->
                <Rectangle Width="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="6,6" VerticalAlignment="Stretch"/>
                <!-- Quick-access toolbar buttons -->
                <Button x:Name="SaveButton" Click="Save_Click"  Padding="7,5" Background="Transparent" BorderThickness="0" CornerRadius="4" ToolTipService.ToolTip="Save (Ctrl+S)"
                        AutomationProperties.Name="Save (Ctrl+S)">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control"/>
                    </Button.KeyboardAccelerators>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74E;" FontSize="14"/>
                </Button>
                <Button x:Name="NewButton" Click="New_Click"   Padding="7,5" Background="Transparent" BorderThickness="0" CornerRadius="4" ToolTipService.ToolTip="New"
                        AutomationProperties.AutomationId="QuickAccessNewButton"
                        AutomationProperties.Name="New">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A5;" FontSize="14"/>
                </Button>
                <Button x:Name="UndoButton" AutomationProperties.AutomationId="UndoButton" Click="Undo_Click"  Padding="7,5" Background="Transparent" BorderThickness="0" CornerRadius="4" ToolTipService.ToolTip="Undo (Ctrl+Z)">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7A7;" FontSize="14"/>
                </Button>
                <Button x:Name="RedoButton" Click="Redo_Click"  Padding="7,5" Background="Transparent" BorderThickness="0" CornerRadius="4" ToolTipService.ToolTip="Redo (Ctrl+Y)"
                        AutomationProperties.Name="Redo (Ctrl+Y)">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7A6;" FontSize="14"/>
                </Button>
                <Rectangle Width="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="6,6" VerticalAlignment="Stretch"/>
                <Button x:Name="ThemeToggleButton" Click="ThemeToggle_Click" Padding="7,5" Background="Transparent" BorderThickness="0" CornerRadius="4" ToolTipService.ToolTip="Toggle Theme"
                        AutomationProperties.AutomationId="ThemeToggleButton">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE793;" FontSize="14"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══ RIBBON ═══ -->
        <Border x:Name="RibbonBar" Grid.Row="1" AutomationProperties.AutomationId="RibbonBar"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="4"
                Height="100">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />  <!-- Clipboard -->
                    <ColumnDefinition Width="Auto" />  <!-- Sep -->
                    <ColumnDefinition Width="Auto" />  <!-- Font -->
                    <ColumnDefinition Width="Auto" />  <!-- Sep -->
                    <ColumnDefinition Width="Auto" />  <!-- Paragraph -->
                    <ColumnDefinition Width="Auto" />  <!-- Sep -->
                    <ColumnDefinition Width="Auto" />  <!-- Insert -->
                    <ColumnDefinition Width="Auto" />  <!-- Sep -->
                    <ColumnDefinition Width="*"    />  <!-- Editing -->
                </Grid.ColumnDefinitions>

                <!-- ══ CLIPBOARD ══ -->
                <Grid Grid.Column="0" Padding="6,0,6,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="18"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Large Paste SplitButton: primary=rich paste, dropdown=plain/special -->
                        <SplitButton x:Name="PasteSplitButton" Grid.Column="0" Click="PasteSplitButton_Click"
                                     Width="48" Height="56" Padding="0" CornerRadius="4"
                                     Background="Transparent" BorderThickness="0"
                                     ToolTipService.ToolTip="Paste (Ctrl+V)"
                                     VerticalAlignment="Top" Margin="0,2,4,0"
                                     AutomationProperties.AutomationId="PasteSplitButton"
                                     AutomationProperties.Name="Paste (Ctrl+V)">
                            <SplitButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem x:Uid="PastePlainRibbonLabel" Text="Paste Plain" Click="PastePlain_Click"
                                                    AutomationProperties.AutomationId="PastePlainMenuItem">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77F;"/></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Uid="PasteSpecialRibbonItem" Text="Paste Special..." Click="PasteSpecial_Click"
                                                    AutomationProperties.AutomationId="PasteSpecialRibbonMenuItem">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77F;"/></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </SplitButton.Flyout>
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE77F;" FontSize="24"/>
                                <TextBlock x:Uid="PasteRibbonLabel" Text="Paste" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </SplitButton>
                        <!-- Cut / Copy / Paste Special stacked -->
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Top" Margin="0,4,0,0">
                            <Button Click="Cut_Click" Height="26" Padding="6,2" CornerRadius="4"
                                    Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Cut (Ctrl+X)"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C6;" FontSize="13"/>
                                    <TextBlock x:Uid="CutRibbonLabel" Text="Cut" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Click="Copy_Click" Height="26" Padding="6,2" CornerRadius="4"
                                    Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Copy (Ctrl+C)"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C8;" FontSize="13"/>
                                    <TextBlock x:Uid="CopyRibbonLabel" Text="Copy" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Uid="ClipboardGroupLabel" Grid.Row="1" Text="Clipboard" FontSize="10" HorizontalAlignment="Center"
                               VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>

                <Rectangle Grid.Column="1" Width="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,6" VerticalAlignment="Stretch"/>

                <!-- ══ FONT ══ -->
                <Grid Grid.Column="2" Padding="6,4,6,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                    </Grid.RowDefinitions>

                    <!-- Row 1: font family · font size · grow · shrink -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="3" Margin="0,0,0,3">
                        <ComboBox x:Name="FontFamilyComboBox" Width="158" Height="32"
                                  AutomationProperties.AutomationId="FontFamilyComboBox"
                                  SelectionChanged="FontFamilyComboBox_SelectionChanged"
                                  IsEditable="True" MaxDropDownHeight="350"
                                  DropDownOpened="FontFamilyComboBox_DropDownOpened"
                                  Loaded="FontFamilyComboBox_Loaded"/>
                        <ComboBox x:Name="FontSizeComboBox" Width="62" Height="32"
                                  AutomationProperties.AutomationId="FontSizeComboBox"
                                  SelectionChanged="FontSizeComboBox_SelectionChanged"
                                  IsEditable="True"/>
                        <Button x:Name="GrowFontButton" Click="GrowFont_Click" Width="32" Height="32" Padding="0" CornerRadius="4"
                                Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Grow Font"
                                AutomationProperties.Name="Grow Font">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8E8;" FontSize="13"/>
                        </Button>
                        <Button x:Name="ShrinkFontButton" Click="ShrinkFont_Click" Width="32" Height="32" Padding="0" CornerRadius="4"
                                Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Shrink Font"
                                AutomationProperties.Name="Shrink Font">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8E7;" FontSize="13"/>
                        </Button>
                    </StackPanel>

                    <!-- Row 2: B  I  U  S  x₂  x²  FontColor  Highlight -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="0">
                        <ToggleButton x:Name="BoldToggle" IsChecked="{x:Bind ViewModel.IsBold, Mode=TwoWay}" Click="Bold_Click" Width="32" Height="32" Padding="0" CornerRadius="4"
                                       AutomationProperties.AutomationId="BoldToggle"
                                       Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Bold (Ctrl+B)">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8DD;" FontSize="16"/>
                        </ToggleButton>
                        <ToggleButton x:Name="ItalicToggle" IsChecked="{x:Bind ViewModel.IsItalic, Mode=TwoWay}" Click="Italic_Click" Width="32" Height="32" Padding="0" CornerRadius="4"
                                       AutomationProperties.AutomationId="ItalicToggle"
                                       Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Italic (Ctrl+I)">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8DB;" FontSize="16"/>
                        </ToggleButton>
                        <ToggleButton x:Name="UnderlineToggle" IsChecked="{x:Bind ViewModel.IsUnderline, Mode=TwoWay}" Click="Underline_Click" Width="32" Height="32" Padding="0" CornerRadius="4"
                                       AutomationProperties.AutomationId="UnderlineToggle"
                                       Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Underline (Ctrl+U)">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8DC;" FontSize="16"/>
                        </ToggleButton>
                        <ToggleButton x:Name="StrikethroughToggle" IsChecked="{x:Bind ViewModel.IsStrikethrough, Mode=TwoWay}" Click="Strikethrough_Click" Width="32" Height="32" Padding="0" CornerRadius="4"
                                       AutomationProperties.AutomationId="StrikethroughToggle"
                                       Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Strikethrough">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEDE0;" FontSize="16"/>
                        </ToggleButton>
                        <ToggleButton x:Name="SubscriptToggle" IsChecked="{x:Bind ViewModel.IsSubscript, Mode=TwoWay}" Click="Subscript_Click" Width="32" Height="32" Padding="0" CornerRadius="4"
                                       AutomationProperties.AutomationId="SubscriptToggle"
                                       Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Subscript">
                            <TextBlock FontSize="13" Text="x&#x2082;" IsHitTestVisible="False"/>
                        </ToggleButton>
                        <ToggleButton x:Name="SuperscriptToggle" IsChecked="{x:Bind ViewModel.IsSuperscript, Mode=TwoWay}" Click="Superscript_Click" Width="32" Height="32" Padding="0" CornerRadius="4"
                                       AutomationProperties.AutomationId="SuperscriptToggle"
                                       Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Superscript">
                            <TextBlock FontSize="13" Text="x&#xB2;" IsHitTestVisible="False"/>
                        </ToggleButton>
                        <!-- Font Color with swatch grid -->
                        <Button Padding="4,3" MinWidth="32" Height="32" CornerRadius="4" Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="Font Color (Ctrl+Shift+C)">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="C" Modifiers="Control,Shift" Invoked="ApplyLastFontColor_Invoked"/>
                            </Button.KeyboardAccelerators>
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Spacing="8">
                                        <VariableSizedWrapGrid MaximumRowsOrColumns="6" Orientation="Horizontal" ItemWidth="28" ItemHeight="28">
                                            <Button Click="TextColorSwatchButton_Click" Tag="#000000" Padding="0" MinWidth="0" MinHeight="0" Width="25" Height="25" Margin="1" CornerRadius="12" Background="Transparent" BorderThickness="0"><Ellipse Fill="#000000" Width="20" Height="20" Stroke="#B7B7B7" StrokeThickness="1"/></Button>
                                            <Button Click="TextColorSwatchButton_Click" Tag="#333333" Padding="0" MinWidth="0" MinHeight="0" Width="25" Height="25" Margin="1" CornerRadius="12" Background="Transparent" BorderThickness="0"><Ellipse Fill="#333333" Width="20" Height="20" Stroke="#B7B7B7" StrokeThickness="1"/></Button>
                                            <Button Click="TextColorSwatchButton_Click" Tag="#666666" Padding="0" MinWidth="0" MinHeight="0" Width="25" Height="25" Margin="1" CornerRadius="12" Background="Transparent" BorderThickness="0"><Ellipse Fill="#666666" Width="20" Height="20" Stroke="#B7B7B7" StrokeThickness="1"/></Button>
                                            <Button Click="TextColorSwatchButton_Click" Tag="#a5a5a5" Padding="0" MinWidth="0" MinHeight="0" Width="25" Height="25" Margin="1" CornerRadius="12" Background="Transparent" BorderThickness="0"><Ellipse Fill="#a5a5a5" Width="20" Height="20" Stroke="#B7B7B7" StrokeThickness="1"/></Button>
                                            <Button Click="TextColorSwatchButton_Click" Tag="#ffffff" Padding="0" MinWidth="0" MinHeight="0" Width="25" Height="25" Margin="1" CornerRadius="12" Background="Transparent" BorderThickness="0"><Ellipse Fill="#ffffff" Width="20" Height="20" Stroke="#B7B7B7" StrokeThickness="1"/></Button>
                                            <Button Click="TextColorSwatchButton_Click" Tag="#ff0000" Padding="0" MinWidth="0" MinHeight="0" Width="25" Height="25" Margin="1" CornerRadius="12" Background="Transparent" BorderThickness="0"><Ellipse Fill="#ff0000" Width="20" Height="20" Stroke="#B7B7B7" StrokeThickness="1"/></Button>
                                            <Button Click="TextColorSwatchButton_Click" Tag="#ffc000" Padding="0" MinWidth="0" MinHeight="0" Width="25" Height="25" Margin="1" CornerRadius="12" Background="Transparent" BorderThickness="0"><Ellipse Fill="#ffc000" Width="20" Height="20" Stroke="#B7B7B7" StrokeThickness="1"/></Button>
                                            <Button Click="TextColorSwatchButton_Click" Tag="#ffff00" Padding="0" MinWidth="0" MinHeight="0" Width="25" Height="25" Margin="1" CornerRadius="12" Background="Transparent" BorderThickness="0"><Ellipse Fill="#ffff00" Width="20" Height="20" Stroke="#B7B7B7" StrokeThickness="1"/></Button>
                                            <Button Click="TextColorSwatchButton_Click" Tag="#00b050" Padding="0" MinWidth="0" MinHeight="0" Width="25" Height="25" Margin="1" CornerRadius="12" Background="Transparent" BorderThickness="0"><Ellipse Fill="#00b050" Width="20" Height="20" Stroke="#B7B7B7" StrokeThickness="1"/></Button>
                                            <Button Click="TextColorSwatchButton_Click" Tag="#004dbb" Padding="0" MinWidth="0" MinHeight="0" Width="25" Height="25" Margin="1" CornerRadius="12" Background="Transparent" BorderThickness="0"><Ellipse Fill="#004dbb" Width="20" Height="20" Stroke="#B7B7B7" StrokeThickness="1"/></Button>
                                            <Button Click="TextColorSwatchButton_Click" Tag="#9b00d3" Padding="0" MinWidth="0" MinHeight="0" Width="25" Height="25" Margin="1" CornerRadius="12" Background="Transparent" BorderThickness="0"><Ellipse Fill="#9b00d3" Width="20" Height="20" Stroke="#B7B7B7" StrokeThickness="1"/></Button>
                                            <Button Click="TextColorSwatchButton_Click" Tag="#c0504d" Padding="0" MinWidth="0" MinHeight="0" Width="25" Height="25" Margin="1" CornerRadius="12" Background="Transparent" BorderThickness="0"><Ellipse Fill="#c0504d" Width="20" Height="20" Stroke="#B7B7B7" StrokeThickness="1"/></Button>
                                        </VariableSizedWrapGrid>
                                        <Button x:Uid="MoreColorsButton" Content="More colors..." Click="TextColorMoreColors_Click" HorizontalAlignment="Stretch"/>
                                        <ColorPicker x:Name="TextColorPicker" ColorChanged="TextColorPicker_ColorChanged" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="3"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="A" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                                <Rectangle x:Name="FontColorIndicator" Grid.Row="1" Fill="#E81123" RadiusX="1" RadiusY="1" Margin="1,0"
                                           AutomationProperties.AutomationId="FontColorIndicator"
                                           AutomationProperties.Name="Font color: Red"/>
                            </Grid>
                        </Button>
                        <!-- Highlight Color -->
                        <Button Padding="4,3" MinWidth="32" Height="32" CornerRadius="4" Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="Text Highlight Color">
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Spacing="8">
                                        <VariableSizedWrapGrid MaximumRowsOrColumns="5" Orientation="Horizontal" ItemWidth="28" ItemHeight="28">
                                            <Button Click="HighlightSwatchButton_Click" Tag="#FFFF00" Padding="0" MinWidth="0" MinHeight="0" Width="25" Height="25" Margin="1" CornerRadius="12" Background="Transparent" BorderThickness="0"><Ellipse Fill="#FFFF00" Width="20" Height="20" Stroke="#B7B7B7" StrokeThickness="1"/></Button>
                                            <Button Click="HighlightSwatchButton_Click" Tag="#00FF00" Padding="0" MinWidth="0" MinHeight="0" Width="25" Height="25" Margin="1" CornerRadius="12" Background="Transparent" BorderThickness="0"><Ellipse Fill="#00FF00" Width="20" Height="20" Stroke="#B7B7B7" StrokeThickness="1"/></Button>
                                            <Button Click="HighlightSwatchButton_Click" Tag="#00FFFF" Padding="0" MinWidth="0" MinHeight="0" Width="25" Height="25" Margin="1" CornerRadius="12" Background="Transparent" BorderThickness="0"><Ellipse Fill="#00FFFF" Width="20" Height="20" Stroke="#B7B7B7" StrokeThickness="1"/></Button>
                                            <Button Click="HighlightSwatchButton_Click" Tag="#FF00FF" Padding="0" MinWidth="0" MinHeight="0" Width="25" Height="25" Margin="1" CornerRadius="12" Background="Transparent" BorderThickness="0"><Ellipse Fill="#FF00FF" Width="20" Height="20" Stroke="#B7B7B7" StrokeThickness="1"/></Button>
                                            <Button Click="HighlightSwatchButton_Click" Tag="#0000FF" Padding="0" MinWidth="0" MinHeight="0" Width="25" Height="25" Margin="1" CornerRadius="12" Background="Transparent" BorderThickness="0"><Ellipse Fill="#0000FF" Width="20" Height="20" Stroke="#B7B7B7" StrokeThickness="1"/></Button>
                                            <Button Click="HighlightSwatchButton_Click" Tag="#FF0000" Padding="0" MinWidth="0" MinHeight="0" Width="25" Height="25" Margin="1" CornerRadius="12" Background="Transparent" BorderThickness="0"><Ellipse Fill="#FF0000" Width="20" Height="20" Stroke="#B7B7B7" StrokeThickness="1"/></Button>
                                            <Button Click="HighlightSwatchButton_Click" Tag="#000080" Padding="0" MinWidth="0" MinHeight="0" Width="25" Height="25" Margin="1" CornerRadius="12" Background="Transparent" BorderThickness="0"><Ellipse Fill="#000080" Width="20" Height="20" Stroke="#B7B7B7" StrokeThickness="1"/></Button>
                                            <Button Click="HighlightSwatchButton_Click" Tag="#008080" Padding="0" MinWidth="0" MinHeight="0" Width="25" Height="25" Margin="1" CornerRadius="12" Background="Transparent" BorderThickness="0"><Ellipse Fill="#008080" Width="20" Height="20" Stroke="#B7B7B7" StrokeThickness="1"/></Button>
                                            <Button Click="HighlightSwatchButton_Click" Tag="#008000" Padding="0" MinWidth="0" MinHeight="0" Width="25" Height="25" Margin="1" CornerRadius="12" Background="Transparent" BorderThickness="0"><Ellipse Fill="#008000" Width="20" Height="20" Stroke="#B7B7B7" StrokeThickness="1"/></Button>
                                            <Button Click="HighlightSwatchButton_Click" Tag="#808000" Padding="0" MinWidth="0" MinHeight="0" Width="25" Height="25" Margin="1" CornerRadius="12" Background="Transparent" BorderThickness="0"><Ellipse Fill="#808000" Width="20" Height="20" Stroke="#B7B7B7" StrokeThickness="1"/></Button>
                                        </VariableSizedWrapGrid>
                                        <Button x:Uid="NoHighlightButton" Content="No Highlight" Click="RemoveHighlight_Click" HorizontalAlignment="Stretch"
                                                AutomationProperties.AutomationId="NoHighlightButton"/>
                                        <ColorPicker x:Name="HighlightColorPicker" ColorChanged="HighlightColorPicker_ColorChanged" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="3"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="A" FontSize="14" HorizontalAlignment="Center"/>
                                <Rectangle x:Name="HighlightColorIndicator" Grid.Row="1" Fill="#FFFF00" RadiusX="1" RadiusY="1" Margin="1,0"
                                           AutomationProperties.AutomationId="HighlightColorIndicator"
                                           AutomationProperties.Name="Highlight color: Yellow"/>
                            </Grid>
                        </Button>
                        <!-- Clear Formatting -->
                        <Button x:Name="ClearFormattingButton" Click="ClearFormatting_Click" Width="32" Height="32" Padding="0" CornerRadius="4"
                                AutomationProperties.AutomationId="ClearFormattingButton"
                                Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Clear Formatting"
                                AutomationProperties.Name="Clear Formatting">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8E6;" FontSize="16"/>
                        </Button>
                    </StackPanel>

                    <TextBlock x:Uid="FontGroupLabel" Grid.Row="2" Text="Font" FontSize="10" HorizontalAlignment="Center"
                               VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>

                <Rectangle Grid.Column="3" Width="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,6" VerticalAlignment="Stretch"/>

                <!-- ══ PARAGRAPH ══ -->
                <Grid Grid.Column="4" Padding="6,4,6,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                    </Grid.RowDefinitions>

                    <!-- Row 1: indent decrease · indent increase · list toggle+dropdown · line spacing dropdown -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="0" Margin="0,0,0,3">
                        <Button x:Name="DecreaseIndentButton" Click="DecreaseIndent_Click" Width="32" Height="28" Padding="0" CornerRadius="4"
                                Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Decrease Indent"
                                AutomationProperties.Name="Decrease Indent">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8E7;" FontSize="14"/>
                        </Button>
                        <Button x:Name="IncreaseIndentButton" Click="IncreaseIndent_Click" Width="32" Height="28" Padding="0" CornerRadius="4"
                                Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Increase Indent"
                                AutomationProperties.Name="Increase Indent">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8E8;" FontSize="14"/>
                        </Button>
                        <!-- List type button with dropdown -->
                        <Button x:Name="ListTypeButton" Click="Bullets_Click" Padding="4,3" CornerRadius="4" Height="28"
                                AutomationProperties.AutomationId="ListTypeButton"
                                Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Start a list">
                            <Button.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem x:Name="ListTypeNoneItem" x:Uid="ListTypeNoneItem" Text="None" Click="ListTypeNone_Click"
                                                    AutomationProperties.AutomationId="ListTypeNoneItem"/>
                                    <MenuFlyoutItem x:Name="ListTypeBulletItem" x:Uid="ListTypeBulletItem" Text="Bullet" Click="ListTypeBullet_Click"
                                                    AutomationProperties.AutomationId="ListTypeBulletItem"/>
                                    <MenuFlyoutItem x:Name="ListTypeNumberItem" x:Uid="ListTypeNumberItem" Text="Numbers" Click="ListTypeNumber_Click"
                                                    AutomationProperties.AutomationId="ListTypeNumberItem"/>
                                    <MenuFlyoutItem x:Name="ListTypeLowerLetterItem" x:Uid="ListTypeLowerLetterItem" Text="Lowercase letters" Click="ListTypeLowerLetter_Click"
                                                    AutomationProperties.AutomationId="ListTypeLowerLetterItem"/>
                                    <MenuFlyoutItem x:Name="ListTypeUpperLetterItem" x:Uid="ListTypeUpperLetterItem" Text="Uppercase letters" Click="ListTypeUpperLetter_Click"
                                                    AutomationProperties.AutomationId="ListTypeUpperLetterItem"/>
                                    <MenuFlyoutItem x:Name="ListTypeLowerRomanItem" x:Uid="ListTypeLowerRomanItem" Text="Lowercase Roman" Click="ListTypeLowerRoman_Click"
                                                    AutomationProperties.AutomationId="ListTypeLowerRomanItem"/>
                                    <MenuFlyoutItem x:Name="ListTypeUpperRomanItem" x:Uid="ListTypeUpperRomanItem" Text="Uppercase Roman" Click="ListTypeUpperRoman_Click"
                                                    AutomationProperties.AutomationId="ListTypeUpperRomanItem"/>
                                </MenuFlyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8FD;" FontSize="14"/>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70D;" FontSize="8" VerticalAlignment="Bottom"/>
                            </StackPanel>
                        </Button>
                        <!-- Line spacing dropdown -->
                        <Button x:Name="LineSpacingButton" Padding="4,3" CornerRadius="4" Height="28"
                                AutomationProperties.AutomationId="LineSpacingButton"
                                Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Line Spacing">
                            <Button.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem Text="1.0" Click="LineSpacing_Click" Tag="1.0"/>
                                    <MenuFlyoutItem Text="1.15" Click="LineSpacing_Click" Tag="1.15"/>
                                    <MenuFlyoutItem Text="1.5" Click="LineSpacing_Click" Tag="1.5"/>
                                    <MenuFlyoutItem Text="2.0" Click="LineSpacing_Click" Tag="2.0"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem x:Name="LineSpacingCustomItem" x:Uid="CustomSpacingItem" Text="Custom..." Click="CustomLineSpacing_Click"
                                                    AutomationProperties.AutomationId="LineSpacingCustomItem"/>
                                </MenuFlyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8D4;" FontSize="14"/>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70D;" FontSize="8" VerticalAlignment="Bottom"/>
                            </StackPanel>
                        </Button>
                        <!-- Paragraph spacing -->
                        <Button Padding="4,3" CornerRadius="4" Height="28"
                                Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Paragraph Spacing">
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Spacing="8" Width="200">
                                        <TextBlock x:Uid="ParagraphSpacingHeader" Text="Paragraph Spacing" FontSize="14" FontWeight="SemiBold"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <StackPanel>
                                                <TextBlock x:Uid="SpacingBeforeLabel" Text="Before (pt)" FontSize="11"/>
                                                <NumberBox x:Name="SpacingBeforeBox" Minimum="0" Maximum="100" Value="0"
                                                           SpinButtonPlacementMode="Compact" SmallChange="1"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock x:Uid="SpacingAfterLabel" Text="After (pt)" FontSize="11"/>
                                                <NumberBox x:Name="SpacingAfterBox" Minimum="0" Maximum="100" Value="0"
                                                           SpinButtonPlacementMode="Compact" SmallChange="1"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button x:Uid="ApplySpacingButton" Content="Apply" Click="ApplyParagraphSpacing_Click" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE1D0;" FontSize="14"/>
                        </Button>
                        <!-- Tab Stops -->
                        <Button Click="TabStops_Click" Padding="4,3" CornerRadius="4" Height="28"
                                Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Tab Stops">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7FD;" FontSize="14"/>
                        </Button>
                        <!-- Paragraph Styles -->
                        <Button x:Name="StylesButton" Padding="4,3" CornerRadius="4" Height="28"
                                Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Styles"
                                AutomationProperties.Name="Styles">
                            <Button.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem x:Uid="StyleNormalItem" Text="Normal" Click="StyleNormal_Click"/>
                                    <MenuFlyoutItem x:Uid="StyleHeading1Item" Text="Heading 1" Click="StyleHeading1_Click"/>
                                    <MenuFlyoutItem x:Uid="StyleHeading2Item" Text="Heading 2" Click="StyleHeading2_Click"/>
                                    <MenuFlyoutItem x:Uid="StyleHeading3Item" Text="Heading 3" Click="StyleHeading3_Click"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem x:Uid="StyleSubtitleItem" Text="Subtitle" Click="StyleSubtitle_Click"/>
                                    <MenuFlyoutItem x:Uid="StyleQuoteItem" Text="Quote" Click="StyleQuote_Click"/>
                                </MenuFlyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8D2;" FontSize="14"/>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70D;" FontSize="8" VerticalAlignment="Bottom"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Row 2: alignment buttons (toggle-style, mutually exclusive in code-behind) -->
                    <Grid Grid.Row="1" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="AlignLeftToggle" Grid.Column="0" Click="AlignLeft_Click"
                                      AutomationProperties.AutomationId="AlignLeftToggle"
                                      Height="32" Padding="0" CornerRadius="4"
                                      IsChecked="True" ToolTipService.ToolTip="Align Left"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8E4;" FontSize="14"/>
                        </ToggleButton>
                        <ToggleButton x:Name="AlignCenterToggle" Grid.Column="1" Click="AlignCenter_Click"
                                      AutomationProperties.AutomationId="AlignCenterToggle"
                                      Height="32" Padding="0" CornerRadius="4"
                                      ToolTipService.ToolTip="Align Center"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8E3;" FontSize="14"/>
                        </ToggleButton>
                        <ToggleButton x:Name="AlignRightToggle" Grid.Column="2" Click="AlignRight_Click"
                                      AutomationProperties.AutomationId="AlignRightToggle"
                                      Height="32" Padding="0" CornerRadius="4"
                                      ToolTipService.ToolTip="Align Right"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8E2;" FontSize="14"/>
                        </ToggleButton>
                        <ToggleButton x:Name="AlignJustifyToggle" Grid.Column="3" Click="AlignJustify_Click"
                                      AutomationProperties.AutomationId="AlignJustifyToggle"
                                      Height="32" Padding="0" CornerRadius="4"
                                      ToolTipService.ToolTip="Justify"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE700;" FontSize="14"/>
                        </ToggleButton>
                    </Grid>

                    <TextBlock x:Uid="ParagraphGroupLabel" Grid.Row="2" Text="Paragraph" FontSize="10" HorizontalAlignment="Center"
                               VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>

                <Rectangle Grid.Column="5" Width="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,6" VerticalAlignment="Stretch"/>

                <!-- ══ INSERT ══ -->
                <Grid Grid.Column="6" Padding="6,0,6,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="18"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" ColumnSpacing="6" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Picture with dropdown -->
                        <Button Grid.Column="0" Click="InsertPicture_Click" Width="40" Height="48" Padding="0" CornerRadius="4"
                                Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Picture"
                                VerticalAlignment="Top">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEB9F;" FontSize="22"/>
                                <TextBlock x:Uid="PictureRibbonLabel" Text="Picture" FontSize="9" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- SmrtDoodle -->
                        <Button x:Name="SmrtDoodleButton" Grid.Column="1" Click="PaintDrawing_Click" Width="52" Height="48" Padding="0" CornerRadius="4"
                                Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="SmrtDoodle - Create A Drawing"
                                AutomationProperties.Name="SmrtDoodle - Create A Drawing"
                                VerticalAlignment="Top">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <Image Source="{ThemeResource SmrtDoodleSource}" Height="22" Stretch="Uniform" HorizontalAlignment="Center"/>
                                <TextBlock Text="SmrtDoodle" FontSize="9" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Insert object -->
                        <Button x:Name="ObjectButton" Grid.Column="2" Click="InsertObject_Click" Width="40" Height="48" Padding="0" CornerRadius="4"
                                Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Insert Object"
                                AutomationProperties.Name="Insert Object"
                                VerticalAlignment="Top">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF4A5;" FontSize="22"/>
                                <TextBlock x:Uid="ObjectRibbonLabel" Text="Object" FontSize="9" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Date and Time -->
                        <Button x:Name="DateTimeButton" Grid.Column="3" Click="InsertDateTime_Click" Width="52" Height="48" Padding="0" CornerRadius="4"
                                Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Date and Time"
                                AutomationProperties.Name="Date and Time"
                                VerticalAlignment="Top">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE787;" FontSize="22"/>
                                <TextBlock x:Uid="DateTimeRibbonLabel" Text="Date/Time" FontSize="9" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Insert Hyperlink -->
                        <Button x:Name="HyperlinkButton" Grid.Column="4" Click="InsertHyperlink_Click" Width="40" Height="48" Padding="0" CornerRadius="4"
                                Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Insert Hyperlink"
                                AutomationProperties.Name="Insert Hyperlink"
                                VerticalAlignment="Top">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71B;" FontSize="22"/>
                                <TextBlock x:Uid="LinkRibbonLabel" Text="Link" FontSize="9" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Insert Table -->
                        <Button x:Name="TableButton" Grid.Column="5" Click="InsertTable_Click" Width="40" Height="48" Padding="0" CornerRadius="4"
                                Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Insert Table"
                                AutomationProperties.Name="Insert Table"
                                VerticalAlignment="Top">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE80A;" FontSize="22"/>
                                <TextBlock x:Uid="TableRibbonLabel" Text="Table" FontSize="9" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Insert Symbol -->
                        <Button x:Name="SymbolButton" Grid.Column="6" Click="InsertSymbol_Click" Width="44" Height="48" Padding="0" CornerRadius="4"
                                Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Insert Symbol"
                                AutomationProperties.Name="Insert Symbol"
                                VerticalAlignment="Top">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" FontSize="22"/>
                                <TextBlock x:Uid="SymbolRibbonLabel" Text="Symbol" FontSize="9" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock x:Uid="InsertGroupLabel" Grid.Row="1" Text="Insert" FontSize="10" HorizontalAlignment="Center"
                               VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>

                <Rectangle Grid.Column="7" Width="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,6" VerticalAlignment="Stretch"/>

                <!-- ══ EDITING ══ -->
                <Grid Grid.Column="8" Padding="6,2,6,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="18"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="1">
                        <!-- Find with dropdown flyout -->
                        <Button x:Name="FindButton" Padding="6,2" Height="24" CornerRadius="4" Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                AutomationProperties.AutomationId="FindButton"
                                AutomationProperties.Name="Find (Ctrl+F)">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="F" Modifiers="Control" IsEnabled="False"/>
                            </Button.KeyboardAccelerators>
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Spacing="6" Width="300">
                                        <TextBlock x:Uid="FindFlyoutHeader" Text="Find" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBox x:Name="FindTextBox" x:Uid="FindTextBox" PlaceholderText="Text to look for"
                                                 AutomationProperties.AutomationId="FindTextBox"/>
                                        <CheckBox x:Name="FindMatchCaseCheckBox" x:Uid="FindMatchCaseCheckBox" Content="Match case" IsChecked="False"
                                                  AutomationProperties.AutomationId="FindMatchCaseCheckBox"/>
                                        <CheckBox x:Name="FindWholeWordCheckBox" x:Uid="FindWholeWordCheckBox" Content="Whole word" IsChecked="False"
                                                  AutomationProperties.AutomationId="FindWholeWordCheckBox"/>
                                        <CheckBox x:Name="FindRegexCheckBox" x:Uid="FindRegexCheckBox" Content="Use regular expressions" IsChecked="False"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                            <Button x:Uid="HighlightAllButton" Content="Highlight All" Click="HighlightAllMatches_Click"/>
                                            <Button x:Uid="ClearHighlightsButton" Content="Clear Highlights" Click="ClearHighlights_Click"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                            <Button x:Uid="FindPreviousButton" Content="Find Previous" Click="FindPrevious_Click"/>
                                            <Button x:Uid="FindNextButton" Content="Find Next" Click="FindNext_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE11A;" FontSize="14"/>
                                <TextBlock x:Uid="FindRibbonLabel" Text="Find" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Replace with dropdown flyout -->
                        <Button x:Name="ReplaceButton" Padding="6,2" Height="24" CornerRadius="4" Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                AutomationProperties.AutomationId="ReplaceButton"
                                AutomationProperties.Name="Replace (Ctrl+H)">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="H" Modifiers="Control" IsEnabled="False"/>
                            </Button.KeyboardAccelerators>
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Spacing="6" Width="300">
                                        <TextBlock x:Uid="ReplaceFlyoutHeader" Text="Find &amp; Replace" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBox x:Name="ReplaceFindTextBox" x:Uid="ReplaceFindTextBox" PlaceholderText="Text to look for"
                                                 AutomationProperties.AutomationId="ReplaceFindTextBox"/>
                                        <TextBlock x:Uid="ReplaceFlyoutLabel" Text="Replace" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                        <TextBox x:Name="ReplaceWithTextBox" x:Uid="ReplaceWithTextBox" PlaceholderText="New text"
                                                 AutomationProperties.AutomationId="ReplaceWithTextBox"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                            <Button x:Uid="ReplaceButton" Content="Replace" Click="Replace_Click"/>
                                            <Button x:Uid="ReplaceAllButton" Content="Replace All" Click="ReplaceAll_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8AB;" FontSize="14"/>
                                <TextBlock x:Uid="ReplaceRibbonLabel" Text="Replace" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Select all -->
                        <Button Click="SelectAll_Click" Padding="6,2" Height="24" CornerRadius="4" Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8B3;" FontSize="14"/>
                                <TextBlock x:Uid="SelectAllRibbonLabel" Text="Select all" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock x:Uid="EditingGroupLabel" Grid.Row="1" Text="Editing" FontSize="10" HorizontalAlignment="Center"
                               VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══ EDITOR + RULERS + BACKSTAGE ═══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="VerticalRulerColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SidebarColumn" Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HorizontalRulerRow" Height="0" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Corner block (top-left when both rulers visible) -->
            <Border Grid.Row="0" Grid.Column="0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,1" />

            <!-- Horizontal ruler -->
            <Border x:Name="HRulerBorder" Grid.Row="0" Grid.Column="1"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                <Canvas x:Name="HRulerCanvas" Height="24" SizeChanged="HRulerCanvas_SizeChanged" />
            </Border>

            <!-- Vertical ruler -->
            <Border x:Name="VRulerBorder" Grid.Row="1" Grid.Column="0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <Canvas x:Name="VRulerCanvas" Width="24" SizeChanged="VRulerCanvas_SizeChanged" />
            </Border>

            <!-- Editor + Page View wrapper (tabs) -->
            <TabView x:Name="DocumentTabs" AutomationProperties.AutomationId="DocumentTabs" Loaded="DocumentTabs_Loaded"
                     Grid.Row="1" Grid.Column="1"
                     IsAddTabButtonVisible="True"
                     AddTabButtonClick="DocumentTabs_AddTabButtonClick"
                     TabCloseRequested="DocumentTabs_TabCloseRequested"
                      TabDroppedOutside="DocumentTabs_TabDroppedOutside"
                      CanDragTabs="True"
                     SelectionChanged="DocumentTabs_SelectionChanged"
                     TabWidthMode="SizeToContent"
                     VerticalAlignment="Stretch"
                     Background="Transparent">
            </TabView>

            <!-- Backstage overlay -->
            <views:FileBackstageView x:Name="FileBackstage" Grid.Row="0" Grid.RowSpan="2"
                                     Grid.Column="0" Grid.ColumnSpan="3" Visibility="Collapsed" />

            <!-- Smart Sidebar (Pro only) -->
            <ContentControl x:Name="SidebarHost" Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                            Visibility="Collapsed" />
        </Grid>

        <!-- ═══ STATUS BAR ═══ -->
        <ContentControl x:Name="StatusBar" AutomationProperties.AutomationId="StatusBar" IsTabStop="True" Grid.Row="3" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" Padding="10,4" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                    <TextBlock x:Name="StatusText" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" VerticalAlignment="Center" FontSize="11"
                               AutomationProperties.AutomationId="StatusText"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                    <TextBlock x:Name="WordCountText" Text="{x:Bind ViewModel.WordCountDisplay, Mode=OneWay}" VerticalAlignment="Center" FontSize="11"
                               AutomationProperties.AutomationId="WordCountText"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="CharCountText" Text="{x:Bind ViewModel.CharCountDisplay, Mode=OneWay}" VerticalAlignment="Center" FontSize="11"
                               AutomationProperties.AutomationId="CharCountText"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="SelectionLengthText" Text="{x:Bind ViewModel.SelectionLengthDisplay, Mode=OneWay}" VerticalAlignment="Center" FontSize="11"
                               AutomationProperties.AutomationId="SelectionLengthText"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="LineColText" Text="{x:Bind ViewModel.LineColDisplay, Mode=OneWay}" VerticalAlignment="Center" FontSize="11"
                               AutomationProperties.AutomationId="LineColText"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="EncodingText" Text="{x:Bind ViewModel.EncodingDisplay, Mode=OneWay}" VerticalAlignment="Center" FontSize="11"
                               AutomationProperties.AutomationId="EncodingText"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="ZoomText" Text="{x:Bind ViewModel.ZoomDisplay, Mode=OneWay}" VerticalAlignment="Center" FontSize="11"
                               AutomationProperties.AutomationId="ZoomText"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Slider x:Name="ZoomSlider"
                            Minimum="10" Maximum="500" StepFrequency="10"
                            Value="{x:Bind ViewModel.ZoomLevel, Mode=TwoWay}"
                            Width="120" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="ZoomSlider"
                            AutomationProperties.Name="Zoom slider"
                            ValueChanged="ZoomSlider_ValueChanged"/>
                    <TextBox x:Name="ZoomPercentBox"
                             Width="48" Height="24" FontSize="11"
                             Text="{x:Bind ViewModel.ZoomDisplay, Mode=OneWay}"
                             VerticalAlignment="Center"
                             AutomationProperties.AutomationId="ZoomPercentBox"
                             AutomationProperties.Name="Zoom percentage"
                             KeyDown="ZoomPercentBox_KeyDown"
                             LostFocus="ZoomPercentBox_LostFocus"/>
                </StackPanel>
            </Grid>
        </ContentControl>
    </Grid>
</Window>
