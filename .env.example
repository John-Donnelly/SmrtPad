# SmrtPad local build/test settings.
#
# Copy to `.env` (gitignored) and adjust. Every value here is a build or test
# toggle — no credentials belong in this file, and none are needed to build.

# Build configuration the UI-test deploy script pushes to the test machine.
UITEST_DEPLOY_CONFIGURATION=Debug

# Comma-separated allowlist limiting which models the AI benchmark suite runs.
# Leave unset to run the full matrix.
BENCHMARK_MODEL_FILTER=phi-4-mini,qwen2.5-0.5b

# 1 enables the strict Foundry Local prerequisite gate on deploy; 0 skips it.
SMRTPAD_ENSURE_FOUNDRY=1
