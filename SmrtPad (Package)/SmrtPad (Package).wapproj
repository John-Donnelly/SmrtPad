<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(VisualStudioVersion)' == '' or '$(VisualStudioVersion)' &lt; '15.0'">
    <VisualStudioVersion>15.0</VisualStudioVersion>
  </PropertyGroup>
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup>
    <WapProjPath Condition="'$(WapProjPath)'==''">$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\</WapProjPath>
    <PathToXAMLWinRTImplementations>SmrtPad\</PathToXAMLWinRTImplementations>
    <WinUISDKReferences>false</WinUISDKReferences>
    <AITargetFramework>net8.0-windows10.0.26100.0</AITargetFramework>
    <AIProjectPath>$(MSBuildThisFileDirectory)..\SmrtPad.AI\SmrtPad.AI.csproj</AIProjectPath>
    <AIPackageOutputDir>$(MSBuildProjectDirectory)\bin\$(Platform)\$(Configuration)\AppX\SmrtPad\AI\</AIPackageOutputDir>
    <AIPlatform Condition="'$(AIPlatform)' == ''">$(Platform)</AIPlatform>
    <AIOutputDir>$(MSBuildThisFileDirectory)..\SmrtPad.AI\bin\$(AIPlatform)\$(Configuration)\$(AITargetFramework)\</AIOutputDir>
    <!-- RID string used to probe runtimes/{rid}/native/ when native assets are not flat. -->
    <AIRuntimeIdentifier Condition="'$(AIPlatform)' == 'x64'">win-x64</AIRuntimeIdentifier>
    <AIRuntimeIdentifier Condition="'$(AIPlatform)' == 'ARM64'">win-arm64</AIRuntimeIdentifier>
  </PropertyGroup>
  <!-- Tell VS fast up-to-date check about the AI plugin DLL so the WAP project is
       considered out-of-date whenever SmrtPad.AI is rebuilt, ensuring CopySmrtPadAiOutputs
       fires and the AppX AI\ directory stays in sync. -->
  <ItemGroup>
    <UpToDateCheckInput  Include="$(AIOutputDir)SmrtPad.AI.dll" Set="AIPlugin" />
    <UpToDateCheckOutput Include="$(AIPackageOutputDir)SmrtPad.AI.dll" Set="AIPlugin" />
    <!-- Track native core DLL so VS re-deploys if it appears or changes in the build output.
         The input covers both the flat layout (RuntimeIdentifier build) and the runtimes layout. -->
    <UpToDateCheckInput  Include="$(AIOutputDir)Microsoft.AI.Foundry.Local.Core.dll" Set="AIPlugin" />
    <UpToDateCheckInput  Include="$(AIOutputDir)runtimes\$(AIRuntimeIdentifier)\native\Microsoft.AI.Foundry.Local.Core.dll" Set="AIPlugin" Condition="'$(AIRuntimeIdentifier)' != ''" />
    <UpToDateCheckOutput Include="$(AIPackageOutputDir)Microsoft.AI.Foundry.Local.Core.dll" Set="AIPlugin" />
  </ItemGroup>
  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.props" />
  <PropertyGroup>
    <ProjectGuid>db6b578e-a819-443b-9181-b6f109ca12d8</ProjectGuid>
    <TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <AppxOSMinVersionReplaceManifestVersion>false</AppxOSMinVersionReplaceManifestVersion>
    <AppxOSMaxVersionTestedReplaceManifestVersion>false</AppxOSMaxVersionTestedReplaceManifestVersion>
    <AssetTargetFallback>net8.0-windows$(TargetPlatformVersion);$(AssetTargetFallback)</AssetTargetFallback>
    <DefaultLanguage>en-US</DefaultLanguage>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <EntryPointProjectUniqueName>..\SmrtPad\SmrtPad.csproj</EntryPointProjectUniqueName>
  </PropertyGroup>
  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>
  <ItemGroup>
    <Content Include="deploy.ps1" />
    <Content Include="Images\SplashScreen.scale-200.png" />
    <Content Include="Images\LockScreenLogo.scale-200.png" />
    <Content Include="Images\Square150x150Logo.scale-200.png" />
    <Content Include="Images\Square44x44Logo.scale-200.png" />
    <Content Include="Images\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Images\StoreLogo.png" />
    <Content Include="Images\Wide310x150Logo.scale-200.png" />
    <Content Include="Properties\PublishProfiles\win-ARM64.pubxml" />
    <Content Include="Properties\PublishProfiles\win-x64.pubxml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SmrtPad\SmrtPad.csproj">
      <SkipGetTargetFrameworkProperties>True</SkipGetTargetFrameworkProperties>
      <PublishProfile>Properties\PublishProfiles\win-$(Platform).pubxml</PublishProfile>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>
  <Target Name="CopySmrtPadAiOutputs" AfterTargets="Build">
    <MSBuild Projects="$(AIProjectPath)" Targets="Build" Properties="Configuration=$(Configuration);Platform=$(AIPlatform)" />
    <ItemGroup>
      <SmrtPadAiOutputs Include="$(AIOutputDir)*" />
      <!-- Native DLLs from the runtimes layout (present when RuntimeIdentifier is not set during
           the nested build, e.g. Debug).  Copy them flat alongside the managed assemblies so the
           AIAssemblyLoadContext can locate them without needing a runtimes subdirectory in AppX. -->
      <SmrtPadAiNativeRuntimeOutputs Include="$(AIOutputDir)runtimes\$(AIRuntimeIdentifier)\native\*"
                                      Condition="'$(AIRuntimeIdentifier)' != ''" />
    </ItemGroup>
    <MakeDir Directories="$(AIPackageOutputDir)" />
    <Copy SourceFiles="@(SmrtPadAiOutputs)" DestinationFiles="@(SmrtPadAiOutputs->'$(AIPackageOutputDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(SmrtPadAiNativeRuntimeOutputs)" DestinationFiles="@(SmrtPadAiNativeRuntimeOutputs->'$(AIPackageOutputDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.targets" />
</Project>