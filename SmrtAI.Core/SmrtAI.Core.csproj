<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Enable RID-specific restore targets so this shared library can be bundled into
         SmrtDoodle's self-contained MSIX publish (win-x64/win-x86/win-arm64). Without this,
         a RID-less restore (left by any plain build/test) makes the packaging build fail
         with NETSDK1047. RuntimeIdentifiers (plural) only adds restore targets; it does not
         make the library itself build self-contained. -->
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64</RuntimeIdentifiers>
    <RootNamespace>SmrtAI.Core</RootNamespace>
    <AssemblyName>SmrtAI.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <IsPackable>true</IsPackable>
    <PackageId>SmrtAI.Core</PackageId>
    <Authors>JAD Apps</Authors>
    <Company>JAD Apps</Company>
    <Description>Shared AI dispatcher abstractions and SmrtSuite IPC contract used by SmrtPad and SmrtDoodle.</Description>
    <PackageTags>smrtsuite;ai;ipc;abstractions</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
</Project>
