<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Pure .NET project — no WinUI SDK needed; tests drive the app from outside -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Enforce single-process sequential execution so ClearStartupBlockers() does not
         kill a SmrtPad.exe instance owned by a concurrently-running test class. -->
    <RunSettingsFilePath>$(SolutionDir)SmrtPad.UITests.runsettings</RunSettingsFilePath>
    <!--
      UI automation tests require:
        1. Appium 2.x server running  (npm install -g appium && appium)
        2. appium-windows-driver      (appium driver install windows)
        3. WinAppDriver 1.2.1         (https://github.com/microsoft/WinAppDriver/releases)
           running at http://127.0.0.1:4723  (started before the test run)
      Tests are marked [SkippableFact] and skip gracefully when the server is absent.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.skippablefact" />
    <PackageReference Include="Appium.WebDriver" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
