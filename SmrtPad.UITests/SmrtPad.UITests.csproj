<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Pure .NET project — no WinUI SDK needed; tests drive the app from outside -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      UI automation tests require:
        1. Appium 2.x server running  (npm install -g appium && appium)
        2. appium-windows-driver      (appium driver install windows)
        3. WinAppDriver 1.2.1         (https://github.com/microsoft/WinAppDriver/releases)
           running at http://127.0.0.1:4723  (started before the test run)
      Tests are marked [SkippableFact] and skip gracefully when the server is absent.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk"       Version="17.8.0" />
    <PackageReference Include="xunit"                        Version="2.6.6"  />
    <PackageReference Include="xunit.runner.visualstudio"    Version="2.5.6"  />
    <PackageReference Include="xunit.skippablefact"          Version="1.5.61" />
    <PackageReference Include="Appium.WebDriver"             Version="8.1.0"  />
    <PackageReference Include="coverlet.collector"           Version="6.0.0"  />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
