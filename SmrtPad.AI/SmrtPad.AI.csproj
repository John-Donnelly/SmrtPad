<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <OutputType>Library</OutputType>
    <RootNamespace>SmrtPad.AI</RootNamespace>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!--
      Set a specific RuntimeIdentifier so the NuGet package build targets extract
      native DLLs (e.g. Microsoft.AI.Foundry.Local.Core.dll, onnxruntime-genai.dll)
      from runtimes/{rid}/native/ into the output root.  Without this, those DLLs stay
      in the runtimes subdirectory and cannot be found at runtime.
    -->
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64' AND '$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64' AND '$(RuntimeIdentifier)' == ''">win-arm64</RuntimeIdentifier>
    <!--
      Keep outputs in the TFM-only directory (no win-x64/win-arm64 subdirectory) so that
      AIOutputDir in the wapproj's CopySmrtPadAiOutputs target can locate every file —
      including the native Microsoft.AI.Foundry.Local.Core.dll — with its flat glob.
      Without this, AppendRuntimeIdentifierToOutputPath=true (the SDK default) routes all
      outputs into a RID-qualified subdirectory that the glob never reaches.
    -->
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <NoWarn>$(NoWarn);NU1603</NoWarn>
    <!--
      Library projects do not copy NuGet package assemblies to their output by default.
      This plugin is loaded at runtime via AssemblyLoadContext, so all managed and native
      dependencies must be physically present alongside SmrtPad.AI.dll in the AppX directory.
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Direct reference required so the package's build/ MSBuild targets activate and copy
      runtimes/win-x64(arm64)/native/ CUDA-enabled onnxruntime-genai.dll to the output dir.
    -->
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI.Cuda" />
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI.Managed" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="System.Management" />
    <!-- LLamaSharp: llama.cpp GGUF runner (CPU + CUDA 12). Both backends included so the
         correct native library is selected at runtime based on hardware availability. -->
    <PackageReference Include="LLamaSharp" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" />
    <PackageReference Include="LLamaSharp.Backend.Cuda12" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SmrtPad.AI.Tests" />
    <InternalsVisibleTo Include="SmrtPad.AI.Benchmarks" />
  </ItemGroup>
</Project>
