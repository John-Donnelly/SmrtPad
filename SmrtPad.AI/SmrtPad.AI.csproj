<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <OutputType>Library</OutputType>
    <RootNamespace>SmrtPad.AI</RootNamespace>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!--
      Set a specific RuntimeIdentifier so the NuGet package build targets extract
      native DLLs (e.g. Microsoft.AI.Foundry.Local.Core.dll, onnxruntime-genai.dll)
      from runtimes/{rid}/native/ into the output root.  Without this, those DLLs stay
      in the runtimes subdirectory and cannot be found at runtime.
    -->
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64' AND '$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64' AND '$(RuntimeIdentifier)' == ''">win-arm64</RuntimeIdentifier>
    <!--
      Keep outputs in the TFM-only directory (no win-x64/win-arm64 subdirectory) so that
      AIOutputDir in the wapproj's CopySmrtPadAiOutputs target can locate every file —
      including the native Microsoft.AI.Foundry.Local.Core.dll — with its flat glob.
      Without this, AppendRuntimeIdentifierToOutputPath=true (the SDK default) routes all
      outputs into a RID-qualified subdirectory that the glob never reaches.
    -->
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <NoWarn>$(NoWarn);NU1603</NoWarn>
    <!--
      Library projects do not copy NuGet package assemblies to their output by default.
      This plugin is loaded at runtime via AssemblyLoadContext, so all managed and native
      dependencies must be physically present alongside SmrtPad.AI.dll in the AppX directory.
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Direct reference required so the package's build/ MSBuild targets activate and copy
      runtimes/win-x64(arm64)/native/ CUDA-enabled onnxruntime-genai.dll to the output dir.
    -->
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI.Cuda" />
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI.Managed" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="System.Management" />
    <!-- LLamaSharp: llama.cpp GGUF runner (CPU + CUDA 12). Both backends included so the
         correct native library is selected at runtime based on hardware availability. -->
    <PackageReference Include="LLamaSharp" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" />
    <PackageReference Include="LLamaSharp.Backend.Cuda12" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SmrtPad.AI.Tests" />
    <InternalsVisibleTo Include="SmrtPad.AI.Benchmarks" />
  </ItemGroup>

  <!--
    Copy CUDA 12 runtime DLLs (cudart64_12, cublas64_12, cublasLt64_12) from the Python
    NVIDIA packages into the cuda12 output subdirectory alongside ggml-cuda.dll.
    These are required transitive dependencies of ggml-cuda.dll that are not bundled with
    LLamaSharp.Backend.Cuda12 — they ship with the CUDA Toolkit or the pip nvidia-* packages.
    Installing the full CUDA Toolkit is not required; the three DLLs are sufficient.
    The pip packages (nvidia-cuda-runtime-cu12, nvidia-cublas-cu12) must be installed:
      pip install nvidia-cuda-runtime-cu12 nvidia-cublas-cu12
    The LOCALAPPDATA path below is the default for a per-user Python 3.10 install on Windows.
    Update $(PythonSitePackages) in Directory.Build.props if your Python path differs.
  -->
  <PropertyGroup>
    <PythonSitePackages Condition="'$(PythonSitePackages)' == ''">$(LOCALAPPDATA)\Programs\Python\Python310\Lib\site-packages</PythonSitePackages>
    <CudaRuntimeSrc>$(PythonSitePackages)\nvidia\cuda_runtime\bin</CudaRuntimeSrc>
    <CublasSrc>$(PythonSitePackages)\nvidia\cublas\bin</CublasSrc>
    <Cuda12OutDir>$(OutputPath)runtimes\win-x64\native\cuda12\</Cuda12OutDir>
  </PropertyGroup>

  <Target Name="CopyCudaRuntimeDlls" AfterTargets="Build"
          Condition="'$(RuntimeIdentifier)' == 'win-x64' OR '$(Platform)' == 'x64'">
    <ItemGroup>
      <_CudaRuntimeDlls Include="$(CudaRuntimeSrc)\cudart64_12.dll"
                        Condition="Exists('$(CudaRuntimeSrc)\cudart64_12.dll')" />
      <_CudaRuntimeDlls Include="$(CublasSrc)\cublas64_12.dll"
                        Condition="Exists('$(CublasSrc)\cublas64_12.dll')" />
      <_CudaRuntimeDlls Include="$(CublasSrc)\cublasLt64_12.dll"
                        Condition="Exists('$(CublasSrc)\cublasLt64_12.dll')" />
    </ItemGroup>
    <MakeDir Directories="$(Cuda12OutDir)" />
    <Copy SourceFiles="@(_CudaRuntimeDlls)"
          DestinationFolder="$(Cuda12OutDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_CudaRuntimeDlls)' != ''" />
    <Warning Text="CUDA runtime DLLs not found at $(CudaRuntimeSrc) / $(CublasSrc). GPU inference will fall back to CPU. Install with: pip install nvidia-cuda-runtime-cu12 nvidia-cublas-cu12"
             Condition="'@(_CudaRuntimeDlls)' == ''" />
  </Target>

</Project>
