<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <OutputType>Library</OutputType>
    <RootNamespace>SmrtPad.AI</RootNamespace>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <NoWarn>$(NoWarn);NU1603</NoWarn>
    <!--
      Library projects do not copy NuGet package assemblies to their output by default.
      This plugin is loaded at runtime via AssemblyLoadContext, so all managed and native
      dependencies must be physically present alongside SmrtPad.AI.dll in the AppX directory.
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AI.Foundry.Local" />
    <!--
      Direct reference required so the package's build/ MSBuild targets activate and copy
      runtimes/win-x64(arm64)/native/Microsoft.AI.Foundry.Local.Core.dll to the output dir.
      The buildTransitive/ variant that propagates from the parent package does not include
      the native-copy target.
    -->
    <PackageReference Include="Microsoft.AI.Foundry.Local.Core" />
    <!--
      Direct reference required for the same reason as Microsoft.AI.Foundry.Local.Core above:
      Microsoft.ML.OnnxRuntimeGenAI is only a transitive dependency of
      Microsoft.AI.Foundry.Local.Core, so its build/ targets never fire and
      onnxruntime-genai.dll is never copied to the output dir.
      Note: the .Foundry variant does not ship onnxruntime-genai.dll as a native asset;
      the base package must be referenced directly.
    -->
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="System.Management" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SmrtPad.AI.Tests" />
  </ItemGroup>
</Project>
