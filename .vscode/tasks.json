{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "launch-smrtpad",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile", "-Command",
                "Stop-Process -Name SmrtPad -Force -ErrorAction SilentlyContinue; Start-Sleep -Milliseconds 500; Start-Process 'shell:AppsFolder\\JohnDonnelly.SmrtPad_30vn2v44e6ykm!App'; $deadline = (Get-Date).AddSeconds(15); do { Start-Sleep -Milliseconds 300 } until ((Get-Process -Name SmrtPad -ErrorAction SilentlyContinue) -or (Get-Date) -gt $deadline)"
            ],
            "presentation": { "reveal": "silent", "panel": "shared" },
            "dependsOn": "build"
        },
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/SmrtPad/SmrtPad.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary",
                "-c", "Debug",
                "-p:Platform=x64",
                "-r", "win-x64"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
